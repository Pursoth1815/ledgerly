<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
         Profile builds are never released; the release check covers release
         builds only (ADR 0017).
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Phase 0B: lets the spike lab show Android's own "let app always run
         in background?" dialog. Whether the real app asks for this is decided
         from the Phase 0B results. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application>
        <!-- Phase 0B spike lab: a second launcher icon, "Loopd Spikes", in
             profile builds only. Release builds never contain it. -->
        <activity
            android:name="com.pursoth.loopd.spikes.SpikeLabActivity"
            android:exported="true"
            android:label="Loopd Spikes"
            android:taskAffinity="com.pursoth.loopd.spikes"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:configChanges="orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Phase 0B locked-phone test: an alarm that starts expedited work. -->
        <receiver
            android:name="com.pursoth.loopd.spikes.SpikeAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
