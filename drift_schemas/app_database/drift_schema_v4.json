          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('bank', 'credit_card', 'cash', 'category', 'income', 'loan', 'adjustment', 'write_off', 'opening')), \"name\" TEXT NOT NULL, \"bank_code\" TEXT NULL, \"last4\" TEXT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"removed_at\" INTEGER NULL, PRIMARY KEY (\"id\")) STRICT;"
